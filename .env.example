[TEMPLATE]
# ---------------------------------------------------------------------------
# Backend (Django) - copy to ".env" at the repository root.
# ---------------------------------------------------------------------------
# REQUIRED in production (DEBUG=False): the app refuses to boot without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Never reuse this file in production; set the values in the platform dashboard.
SECRET_KEY=change-me-in-production
DEBUG=True

# PostgreSQL.
#
# Option A - docker compose (project database exposed on host port 5433,
# because 5432 is commonly used by an existing local PostgreSQL):
#   docker compose up -d db
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/liga_efootball
#
# Option B - PostgreSQL already installed on the default port:
#   createdb liga_efootball
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/liga_efootball
#
# Option C - Neon (production). Use the *pooled* connection string
# (hostname contains "-pooler") and keep sslmode=require:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Optional: Neon *direct* endpoint, used only by migrations. If empty,
# migrations use DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Neon suspends idle computes and closes connections after ~5 minutes, so keep
# the reuse window short and let Django health-check connections.
# DATABASE_CONN_MAX_AGE=300
# DATABASE_SSL_REQUIRE=True

# SQLite fallback is used if DATABASE_URL is empty (tests/dev only).

# Comma separated list of hostnames.
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Origin of the single service that serves the SPA and the API (same origin).
# Required by Django for CSRF over HTTPS, e.g. https://liga-amigos.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Production: comma-separated emails that should be league admins. The account
# must already exist; start.sh runs "sync_admins" on every boot. Can also be
# applied once with: python backend/manage.py set_admin email@example.com
# ADMIN_EMAILS=dev.cesar26@gmail.com

# Number of reverse proxies in front of Django. Set 1 on Render/Railway so the
# login throttle uses the real client IP. Leave 0 when exposing the app directly.
# NUM_PROXIES=1

# Optional: force the HTTPS redirect even with DEBUG=True (tests/dev behind a
# local proxy). Production derives it from DEBUG=False. The health check is
# always exempt so platform probes do not get a redirect.
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000

# Optional league rules.
# CONTEST_WINDOW_HOURS=48
# MAX_GOALS_PER_MATCH=30
# WALKOVER_GOALS=3

# ---------------------------------------------------------------------------
# Email / password reset (Brevo API)
# ---------------------------------------------------------------------------
# With DEBUG=True the console backend prints the message in the terminal, so
# local development needs no credentials. In production, set the Brevo API key
# and a sender verified in Brevo; no SMTP host/user/password is needed.
#
# BREVO_API_KEY=xkeysib-sua-chave
# Sender verified in Brevo; also used as the admin account (ADMIN_EMAILS).
# DEFAULT_FROM_EMAIL=Biblioteca <dev.cesar26@gmail.com>
#
# Public origin of the React app, used in the password reset link.
# FRONTEND_URL=https://liga-amigos.onrender.com
# PASSWORD_RESET_TIMEOUT=3600

# Optional SMTP fallback (used only when BREVO_API_KEY is empty). Any provider
# that speaks SMTP works; this is not needed for Brevo API.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=senha
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Not needed in normal use: the app calls "/api" and Vite proxies it to Django
# during development (VITE_PROXY_TARGET), while production is served by Django.
# VITE_API_URL=/api
# VITE_PROXY_TARGET=http://localhost:8000
